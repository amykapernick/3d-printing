# Copy to .env and adjust. docker-compose reads this automatically.

# Superuser the SvelteKit server uses to talk to PocketBase. CHANGE THE PASSWORD.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme-please

# Host ports (container-internal ports are fixed).
APP_PORT=3000
POCKETBASE_PORT=8090
SPOOLMAN_PORT=7912

TZ=Australia/Perth

# Home Assistant (live printer status + AMS slots, via the ha-bambulab integration).
# HA_URL   = your HA base URL, e.g. http://homeassistant.local:8123
# HA_TOKEN = a long-lived access token (HA → your profile → Security → Long-lived tokens)
HA_URL=
HA_TOKEN=

# Etsy Open API v3 (sales import). Leave blank to disable the Etsy UI entirely.
# ETSY_KEYSTRING    = your Etsy app's keystring (developer.etsy.com → your app). Acts as client_id.
# ETSY_SHOP_ID      = your numeric Etsy shop id.
# ETSY_REDIRECT_URI = optional override; defaults to <app-origin>/auth/etsy/callback.
#                     Whatever this resolves to MUST be registered on your Etsy app.
ETSY_KEYSTRING=
ETSY_SHOP_ID=
ETSY_REDIRECT_URI=

# Shared secret for the hourly PocketBase→app Etsy sync cron. Set to any random string
# to enable scheduled imports; leave blank to only sync manually from the Sales page.
CRON_SECRET=
# Where PocketBase reaches the app for that cron (default works in docker-compose).
APP_INTERNAL_URL=http://app:3000
